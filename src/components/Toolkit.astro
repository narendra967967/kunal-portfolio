---
import Icon from './Icon.astro';
import { competencies, toolGroups, topSkills, moreSkills } from '../data/profile';
const toolCount = toolGroups.reduce((n, g) => n + g.tools.length, 0);
---
<section class="container sec" id="toolkit" aria-labelledby="tk-h">
  <header class="sec-head">
    <p class="kicker">Skills and tools</p>
    <h2 id="tk-h">How I <em>build</em></h2>
    <p>My core competencies, the tools I work with, and the skills I'm known for.</p>
  </header>

  <div class="dash-grid">
    <div class="w span-7">
      <div class="w-h">
        <h3><Icon name="grid-3x3" />Core competencies</h3>
        <div class="tabs" role="tablist" aria-label="Competency groups">
          {competencies.map((c, i) => (
            <button class="tab" role="tab" id={`mt-${c.id}`} aria-selected={i === 0 ? 'true' : 'false'} aria-controls={`mx-${c.id}`} tabindex={i === 0 ? 0 : -1} data-tab={c.id}>{c.label}</button>
          ))}
        </div>
      </div>
      <div class="w-b">
        {competencies.map((c, i) => (
          <div class="mx-panel" id={`mx-${c.id}`} role="tabpanel" aria-labelledby={`mt-${c.id}`} hidden={i !== 0}>
            <p class="mx-title">{c.group.group}</p>
            <ul class="comp" role="list">
              {c.group.items.map((it) => <li><Icon name="check" size={15} />{it}</li>)}
            </ul>
          </div>
        ))}
      </div>
    </div>

    <div class="w span-5">
      <div class="w-h"><h3><Icon name="wrench" />Tools</h3><span class="meta">{toolCount} TOOLS</span></div>
      <div class="w-b tools">
        {toolGroups.map((g) => (
          <div class="tgroup">
            <h4>{g.label}</h4>
            <ul class="chips" role="list">{g.tools.map(([m, n]) => <li class="tchip"><i class="mono-ic" style={`background:${g.color}`} aria-hidden="true">{m}</i>{n}</li>)}</ul>
          </div>
        ))}
      </div>
    </div>

    <div class="w span-12">
      <div class="w-h"><h3><Icon name="shield-check" />Top skills</h3></div>
      <ul class="w-b methods" role="list">
        {topSkills.map((m) => <li>{m}</li>)}
        {moreSkills.map((m) => <li class="p">{m}</li>)}
      </ul>
    </div>
  </div>
</section>

<style>
  .tabs { display: flex; gap: 4px; background: var(--surface-2); border: 1px solid var(--line); border-radius: 10px; padding: 3px; overflow-x: auto; scrollbar-width: none; max-width: 100%; }
  .tabs::-webkit-scrollbar { display: none; }
  .tab { flex: 0 0 auto; border: 0; background: none; border-radius: 7px; padding: 6px 12px; font-size: 12.5px; font-weight: 600; color: var(--dim); }
  .tab[aria-selected='true'] { background: var(--surface); color: var(--brand); box-shadow: var(--shadow); }
  .mx-title { margin: 0 0 10px; font-family: var(--mono); font-size: 10.5px; letter-spacing: .08em; color: var(--faint); text-transform: uppercase; }
  .comp { list-style: none; margin: 0; padding: 0; display: flex; flex-direction: column; font-size: 15px; font-weight: 500; }
  .comp li { display: flex; align-items: center; gap: 10px; padding: 11px 0; border-bottom: 1px solid var(--line); }
  .comp li:last-child { border-bottom: 0; }
  .comp :global(.icon) { color: var(--brand-2); }

  .tools { display: flex; flex-direction: column; gap: 14px; }
  .tgroup { display: flex; flex-direction: column; gap: 8px; }
  .tgroup h4 { margin: 0; font-family: var(--mono); font-size: 10.5px; letter-spacing: .1em; color: var(--faint); font-weight: 500; text-transform: uppercase; }
  .tgroup ul { list-style: none; margin: 0; padding: 0; gap: 6px; }

  .methods { list-style: none; margin: 0; display: flex; flex-wrap: wrap; gap: 8px; align-content: flex-start; }
  .methods li { font-size: 13px; font-weight: 500; padding: 6px 12px; border-radius: 999px; background: var(--brand-soft); color: var(--brand); }
  .methods li.p { background: var(--product-soft); color: var(--product); }
</style>
