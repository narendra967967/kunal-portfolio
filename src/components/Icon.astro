---
// Inlines a Lucide icon (ISC licence) at build time, so no icon JavaScript ships to the browser.
import { readFileSync } from 'node:fs';
import { join } from 'node:path';

interface Props { name: string; size?: number; class?: string; label?: string }
const { name, size = 16, class: cls = '', label } = Astro.props;

const cache = ((globalThis as any).__iconCache ??= new Map<string, string>());
let inner = cache.get(name);
if (inner === undefined) {
  const file = join(process.cwd(), 'node_modules', 'lucide-static', 'icons', `${name}.svg`);
  const svg = readFileSync(file, 'utf8');
  inner = svg.replace(/^[\s\S]*?<svg[^>]*>/, '').replace(/<\/svg>\s*$/, '').trim();
  cache.set(name, inner);
}
---
<svg
  xmlns="http://www.w3.org/2000/svg"
  viewBox="0 0 24 24"
  width={size}
  height={size}
  fill="none"
  stroke="currentColor"
  stroke-width="2"
  stroke-linecap="round"
  stroke-linejoin="round"
  class:list={['icon', cls]}
  aria-hidden={label ? undefined : 'true'}
  role={label ? 'img' : undefined}
  aria-label={label}
  set:html={inner}
/>
