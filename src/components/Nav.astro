---
import { Image } from 'astro:assets';
import Icon from './Icon.astro';
import avatar from '../assets/profile/portrait.png';
import { nav, person } from '../data/profile';
import { href, isActive } from '../lib/url';

interface Props { current: string }
const { current } = Astro.props;
---
<header class="nav">
  <div class="container bar">
    <a class="brand" href={href('/')}>
      <span class="ava"><Image src={avatar} alt="" width={72} height={72} loading="eager" /></span>
      <span class="who"><b>{person.shortName}</b><small>{person.jobTitle}</small></span>
    </a>
    <nav class="links" aria-label="Main">
      {nav.map(([p, label]) => <a href={href(p)} aria-current={isActive(current, p) ? 'page' : undefined}>{label}</a>)}
    </nav>
    <div class="nav-r">
      <button class="mode" id="mode" type="button" aria-label="Switch to dark mode">
        <Icon name="sun" size={17} class="sun" /><Icon name="moon" size={17} class="moon" />
      </button>
      <a class="btn pri talk" href="#contact" aria-label="Let's talk"><Icon name="calendar-check" /><span>Let's talk</span></a>
      <button class="menu" id="menu" type="button" aria-expanded="false" aria-controls="sheet" aria-label="Open menu">
        <Icon name="menu" size={20} class="open" /><Icon name="x" size={20} class="close" />
      </button>
    </div>
  </div>
  <nav class="sheet" id="sheet" aria-label="Mobile" hidden>
    {nav.map(([p, label]) => <a href={href(p)} aria-current={isActive(current, p) ? 'page' : undefined}>{label}<Icon name="chevron-right" /></a>)}
  </nav>
</header>

<style>
  .nav {
    position: sticky; top: env(safe-area-inset-top, 0px); z-index: 40;
    margin-inline: calc(var(--gutter) * -1); padding-inline: var(--gutter);
    background: color-mix(in srgb, var(--bg) 84%, transparent);
    backdrop-filter: blur(12px); -webkit-backdrop-filter: blur(12px);
    border-bottom: 1px solid var(--line);
    view-transition-name: site-nav;
  }
  .bar { display: flex; align-items: center; justify-content: space-between; gap: 16px; padding-block: 12px; }
  .brand { display: flex; align-items: center; gap: 10px; text-decoration: none; min-width: 0; }
  .ava { width: 36px; height: 36px; border-radius: 50%; overflow: hidden; flex: 0 0 auto; background: linear-gradient(135deg, var(--arch-a), var(--arch-b)); box-shadow: 0 0 0 2px var(--surface), 0 0 0 3px var(--line-2); }
  .ava :global(img) { width: 100%; height: 100%; object-fit: cover; display: block; }
  .who { display: flex; flex-direction: column; line-height: 1.2; min-width: 0; }
  .who b { font-size: 15px; }
  .who small { font-size: 12px; color: var(--dim); white-space: nowrap; }
  .links { display: flex; gap: 26px; font-size: 14.5px; font-weight: 500; color: var(--dim); }
  .links a { text-decoration: none; padding-block: 4px; border-bottom: 2px solid transparent; }
  .links a:hover { color: var(--brand); }
  .links a[aria-current='page'] { color: var(--fg); border-bottom-color: var(--brand-2); }
  .nav-r { display: flex; align-items: center; gap: 8px; }
  .mode, .menu { width: 40px; height: 40px; border-radius: 10px; border: 1px solid var(--line-2); background: var(--surface); display: grid; place-items: center; color: var(--dim); }
  .mode :global(.moon), .menu :global(.close) { display: none; }
  :global(:root[data-mode='dark']) .mode :global(.sun) { display: none; }
  :global(:root[data-mode='dark']) .mode :global(.moon) { display: block; }
  .menu[aria-expanded='true'] :global(.open) { display: none; }
  .menu[aria-expanded='true'] :global(.close) { display: block; }
  .menu { display: none; }
  .talk { padding: 9px 14px; font-size: 14px; }
  .sheet { display: flex; flex-direction: column; padding-block: 4px 14px; }
  .sheet a { display: flex; justify-content: space-between; align-items: center; padding: 14px 4px; border-top: 1px solid var(--line); text-decoration: none; font-weight: 600; font-size: 17px; }
  .sheet a[aria-current='page'] { color: var(--brand); }
  @media (max-width: 900px) { .links { display: none; } .menu { display: grid; } }
  @media (min-width: 901px) { .sheet { display: none !important; } }
  @media (max-width: 480px) { .who small { display: none; } .talk span { display: none; } .talk { padding: 9px 11px; } }
</style>
