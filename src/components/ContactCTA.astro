---
import { Image } from 'astro:assets';
import Icon from './Icon.astro';
import avatar from '../assets/profile/portrait.png';
import { person, resumePdf } from '../data/profile';
import { href } from '../lib/url';
---
<section class="container contact" id="contact" aria-labelledby="contact-h">
  <div class="c-ava"><Image src={avatar} alt={person.name} width={240} height={240} /></div>
  <div>
    <p class="kicker">Contact</p>
    <h2 id="contact-h">Let's <em>talk</em></h2>
    <p>Open to Senior/Staff Engineer, Tech Lead and Architectural roles.</p>
  </div>
  <div class="reach">
    <div class="mail">
      <a class="addr" href={`mailto:${person.email}`} id="email">{person.email}</a>
      <button type="button" data-copy={person.email}><Icon name="copy" /><span>Copy</span></button>
    </div>
    <div class="row">
      {person.linkedin && <a class="btn" href={person.linkedin} target="_blank" rel="noopener me">LinkedIn <Icon name="arrow-up-right" /></a>}
      {person.github && <a class="btn" href={person.github} target="_blank" rel="noopener me">GitHub <Icon name="arrow-up-right" /></a>}
      <a class="btn pri" href={href(resumePdf)} download><Icon name="download" />Resume</a>
    </div>
  </div>
</section>

<style>
  .contact { margin-block: clamp(28px, 3.6vw, 48px) clamp(32px, 4.5vw, 56px); padding: clamp(22px, 3.5vw, 40px); border-radius: 22px; background: radial-gradient(120% 140% at 0% 0%, var(--arch-a), var(--arch-b)); color: #F3F2E6; display: grid; grid-template-columns: auto minmax(0, 1fr) minmax(0, 1fr); gap: 28px; align-items: center; box-shadow: var(--shadow-lg); }
  @media (max-width: 900px) { .contact { grid-template-columns: minmax(0, 1fr); } }
  .c-ava { width: 120px; height: 120px; border-radius: 50%; overflow: hidden; background: rgba(255,255,255,.12); box-shadow: 0 0 0 4px rgba(219,188,98,.45); }
  .c-ava :global(img) { width: 100%; height: 100%; object-fit: cover; display: block; }
  .kicker { color: #F0DA98; }
  h2 { margin: 8px 0 0; font-size: clamp(30px, 4.4vw, 52px); line-height: 1.05; letter-spacing: -.03em; font-weight: 700; }
  h2 em { font-style: normal; color: #E6CB7C; }
  p:not(.kicker) { margin: 10px 0 0; color: #DEDCC6; }
  .reach { display: flex; flex-direction: column; gap: 12px; min-width: 0; }
  .mail { display: flex; align-items: center; gap: 10px; background: rgba(255,255,255,.1); border: 1px solid rgba(255,255,255,.2); border-radius: 12px; padding: 10px 10px 10px 14px; min-width: 0; }
  .addr { flex: 1; min-width: 0; font-family: var(--mono); font-size: 14px; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; color: #fff; text-decoration: none; }
  .addr:hover { text-decoration: underline; }
  .mail button { display: inline-flex; align-items: center; gap: 6px; border: 0; background: #fff; color: #231F20; font-weight: 600; font-size: 13px; padding: 7px 12px; border-radius: 8px; white-space: nowrap; }
  .row { display: flex; gap: 10px; flex-wrap: wrap; }
  .row .btn { background: rgba(255,255,255,.08); border-color: rgba(255,255,255,.25); color: #fff; }
  .row .btn.pri { background: #DBBC62; color: #231F20; border-color: #DBBC62; }
  :focus-visible { outline-color: #fff; }
</style>
