---
import { Image } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import Pipeline from '../components/Pipeline.astro';
import ContactCTA from '../components/ContactCTA.astro';
import Icon from '../components/Icon.astro';
import avatar from '../assets/profile/portrait.png';
import { person, skills, education, companies, boldSummary } from '../data/profile';
import { breadcrumbSchema, profilePageSchema } from '../lib/schema';

const skillIcons = ['layers', 'gauge', 'plug', 'users', 'sparkles', 'wrench'];
---
<BaseLayout
  title="About"
  description={`About ${person.name}, Tech Lead and Systems Architect with 7+ years in Next.js, web performance and AI workflows: approach, skills and education.`}
  path="/about/"
  markdown="/about.md"
  type="profile"
  schema={[profilePageSchema('/about/', `About ${person.name}`), breadcrumbSchema([['Home', '/'], ['About', '/about/']])]}
>
  <section class="container intro">
    <div class="pic"><Image src={avatar} alt={person.name} width={320} height={320} loading="eager" /></div>
    <div class="txt">
      <p class="kicker">About</p>
      <h1>{person.name}</h1>
      <p class="role">{person.jobTitle} · {person.location}</p>
      <div class="prose">
        {person.summary.map((p) => <p set:html={boldSummary(p)} />)}
      </div>
      <p class="clients"><span>Where I've built</span> {companies.join(' · ')}</p>
    </div>
  </section>

  <Pipeline id="playbook" heading="How I <em>engineer</em>" intro="How I approach a platform, from the first audit to handling scale." />

  <section class="container sec" aria-labelledby="skills-h">
    <header class="sec-head">
      <p class="kicker">Skills</p>
      <h2 id="skills-h">Skills and <em>tools</em></h2>
    </header>
    <div class="skills">
      {skills.map((s, i) => (
        <div class="w">
          <div class="w-h"><h3><Icon name={skillIcons[i]} />{s.group}</h3></div>
          <ul class="w-b">{s.items.map((it) => <li>{it}</li>)}</ul>
        </div>
      ))}
    </div>
  </section>

  <section class="container sec creds" aria-labelledby="creds-h">
    <header class="sec-head">
      <p class="kicker">Learning</p>
      <h2 id="creds-h">My <em>education</em></h2>
    </header>
    <div class="w">
      <div class="w-h"><h3><Icon name="briefcase" />Education</h3><span class="yr">{education.period}</span></div>
      <div class="w-b"><p class="deg">{education.degree}</p><p class="sch">{education.school}</p><p class="sch">Activities: {education.activities}</p></div>
    </div>
  </section>

  <ContactCTA />
</BaseLayout>

<style>
  .intro { display: grid; grid-template-columns: 300px minmax(0, 1fr); gap: clamp(24px, 4vw, 52px); align-items: start; padding-block: clamp(28px, 4.5vw, 52px) 0; }
  @media (max-width: 820px) { .intro { grid-template-columns: minmax(0, 1fr); } }
  .pic { width: min(300px, 70vw); aspect-ratio: 1; border-radius: 50%; overflow: hidden; background: radial-gradient(120% 80% at 50% 10%, var(--arch-a), var(--arch-b)); box-shadow: var(--shadow-lg), 0 0 0 6px var(--surface); }
  .pic :global(img) { width: 100%; height: 100%; object-fit: cover; display: block; }
  .txt { display: flex; flex-direction: column; gap: 12px; min-width: 0; }
  h1 { margin: 0; font-size: clamp(28px, 3.6vw, 42px); line-height: 1.12; letter-spacing: -.022em; }
  .role { margin: 0; font-family: var(--mono); font-size: 13px; letter-spacing: .04em; color: var(--dim); }
  .prose { margin-top: 8px; }
  .prose :global(strong) { color: var(--brand); }
  .clients { margin: 0; font-weight: 600; }
  .clients span { font-family: var(--mono); font-size: 11px; letter-spacing: .1em; color: var(--faint); text-transform: uppercase; font-weight: 500; margin-right: 8px; }
  .skills { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 14px; }
  @media (max-width: 980px) { .skills { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  @media (max-width: 620px) { .skills { grid-template-columns: minmax(0, 1fr); } }
  .skills ul { margin: 0; padding-left: 34px; display: flex; flex-direction: column; gap: 6px; color: var(--dim); font-size: 14.5px; }
  .skills li::marker { color: var(--brand-2); }
  .yr { font-family: var(--mono); font-size: 12.5px; color: var(--faint); }
  .deg { margin: 0 0 4px; font-weight: 600; font-size: 17px; }
  .sch { margin: 0; color: var(--dim); }
</style>
