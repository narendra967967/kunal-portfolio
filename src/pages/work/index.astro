---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import ReportCard from '../../components/ReportCard.astro';
import ContactCTA from '../../components/ContactCTA.astro';
import { breadcrumbSchema } from '../../lib/schema';
import { abs } from '../../lib/url';

const work = (await getCollection('work')).sort((a, b) => a.data.order - b.data.order);
const filters = [['all', 'All'], ['perf', 'Performance'], ['arch', 'Architecture'], ['ai', 'AI workflows']] as const;
const itemList = {
  '@type': 'ItemList',
  name: 'Case studies',
  itemListElement: work.map((w, i) => ({ '@type': 'ListItem', position: i + 1, url: abs(`/work/${w.id}/`), name: w.data.title })),
};
---
<BaseLayout
  title="Case studies"
  description="Case studies by Kunal Prakash: the Livemint move to Next.js, Core Web Vitals at 20M+ monthly users and guardrails for AI-assisted engineering."
  path="/work/"
  markdown="/work.md"
  schema={[breadcrumbSchema([['Home', '/'], ['Work', '/work/']]), itemList]}
>
  <section class="container sec">
    <header class="sec-head">
      <p class="kicker">Case studies</p>
      <h1>My <em>work</em></h1>
      <p>Programs I led, with the scope, my role and the result.</p>
    </header>
    <div class="bar">
      <div class="filters" role="group" aria-label="Filter reports" data-filter-group="work">
        {filters.map(([id, label], i) => <button class="fchip" type="button" data-f={id} aria-pressed={i === 0 ? 'true' : 'false'}>{label}</button>)}
      </div>
      <span class="count" id="work-count" data-unit="CASE STUDY">{work.length} CASE STUDIES</span>
    </div>
    <div class="reports" data-filter-target="work">
      {work.map((e) => <ReportCard entry={e} level="h2" />)}
    </div>
  </section>
  <ContactCTA />
</BaseLayout>

<style>
  .bar { display: flex; justify-content: space-between; align-items: center; gap: 12px; flex-wrap: wrap; }
  .filters { display: flex; gap: 6px; flex-wrap: wrap; }
  .fchip { border: 1px solid var(--line); background: var(--surface); border-radius: 999px; padding: 6px 14px; font-size: 13px; font-weight: 500; color: var(--dim); }
  .fchip[aria-pressed='true'] { background: var(--brand); border-color: var(--brand); color: var(--brand-ink); }
  .count { font-family: var(--mono); font-size: 11px; letter-spacing: .08em; color: var(--faint); }
  .reports { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 16px; }
  @media (max-width: 980px) { .reports { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  @media (max-width: 640px) { .reports { grid-template-columns: minmax(0, 1fr); } }
  .reports :global(.off) { display: none; }
</style>
